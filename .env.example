# Set /api/guide for the server-backed guide; leave empty for reference-only mode.
# This is an HTTP endpoint, never an API secret.
VITE_GUIDE_ENDPOINT=/api/guide

# Browser API key for the 2GIS MapGL map. Store the real value in .env.local.
VITE_2GIS_API_KEY=

# Server credentials belong in .env.server.local; see .env.server.example.
